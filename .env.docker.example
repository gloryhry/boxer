# Copy to .env and set paths on the Docker host. Relative paths are resolved
# against the directory containing docker-compose.x86.yaml / jetson.yaml.
NAV_MAP_DIR=./nav_map
CKPTS_DIR=./ckpts
# Must include indoor_classes.csv; add <name>_classes.csv for custom vocabularies.
VOCAB_DIR=./owl
OUTPUT_DIR=./output/server
SERVER_PORT=18765
# x86 多卡主机上固定注入的 GPU 序号（nvidia-smi 的 index），默认 0。
BOXER_GPU_ID=0

# Optional CPU/compilation limits.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TORCHINDUCTOR_COMPILE_THREADS=1

# Upload limits (bytes, entry count and idle seconds).
BOXER_UPLOAD_CHUNK_SIZE=8388608
BOXER_UPLOAD_MAX_ZIP_BYTES=21474836480
BOXER_UPLOAD_MAX_EXPANDED_BYTES=107374182400
BOXER_UPLOAD_MAX_FILES=200000
BOXER_UPLOAD_TTL_SECONDS=86400
