# Copy to .env and set paths on the Docker host. Relative paths are resolved
# against the directory containing docker-compose.x86.yaml / jetson.yaml.
NAV_MAP_DIR=./nav_map
CKPTS_DIR=./ckpts
# Must include indoor_classes.csv; add <name>_classes.csv for custom vocabularies.
VOCAB_DIR=./owl
OUTPUT_DIR=./output/server
SERVER_PORT=18765

# Optional CPU/compilation limits.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TORCHINDUCTOR_COMPILE_THREADS=1
